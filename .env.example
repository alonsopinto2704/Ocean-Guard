# Internal URL used by the Node gateway. Website visitors never call this directly.
AI_SERVICE_URL="http://127.0.0.1:8000"
ESPADA_SERVICE_TOKEN="replace-with-a-long-random-secret"
OCEANGUARD_SESSION_SECRET="replace-with-a-different-long-random-secret"

# Espada requires no paid AI API key. These optional settings tune self-hosted inference.
OCEANGUARD_CONFIDENCE_THRESHOLD="0.35"
ESPADA_BOOTSTRAP_ENABLED="true"
OCEANGUARD_MAX_UNREVIEWED_ANALYSES="500"
